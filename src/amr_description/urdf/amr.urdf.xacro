<?xml version="1.0"?>
<!--
  amr.urdf.xacro
  ==============
  Entry point. Pulls in the two files in order:
    1. amr_description.urdf.xacro  (links/joints - the "urdf" file)
    2. amr_gazebo.xacro             (sensors/ros2_control - the "plugin" file)
-->
<robot name="amr" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find amr_description)/urdf/amr_description.urdf.xacro"/>
  <xacro:include filename="$(find amr_description)/urdf/amr_gazebo.xacro"/>

</robot>